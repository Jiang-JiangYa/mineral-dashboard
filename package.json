{
  "name": "mineral-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "backend": ".venv\\Scripts\\python.exe -m uvicorn serve.app:app --host 127.0.0.1 --port 8000",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest tests/backend -q",
    "collect": ".venv\\Scripts\\python.exe -m pipeline collect",
    "evaluate": ".venv\\Scripts\\python.exe -m eval.run"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
