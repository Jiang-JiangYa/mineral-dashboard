# Copy to .env; never commit credentials or licensed exports.
DATA_DIR=data
TZ=Asia/Shanghai
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Optional: protects POST /api/collect and /api/eval. Otherwise loopback clients only.
MANAGEMENT_TOKEN=

# hash: no API key/download; sentence-transformers: multilingual semantic model
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=intfloat/multilingual-e5-small

REQUEST_TIMEOUT=15
REQUEST_INTERVAL=1
HTTP_RETRIES=2
USER_AGENT=MineralDashboard/0.3 (research; polite crawler)

# Override with RSS links supplied by the task owner when available.
MINING_RSS_URLS=https://www.mining.com/feed/
SPGLOBAL_RSS_URLS=
# Comma-separated public policy listing/detail pages (never put secrets in URLs).
DISR_URLS=https://www.industry.gov.au/news,https://www.industry.gov.au/publications/critical-minerals-strategy-2023-2030
REGCC_URLS=https://www.regcc.cn/zgxtjt/cydt/list.shtml,https://www.regcc.cn/zgxtjt/gsgg/list.shtml

# Authorized CSV/JSON data endpoints. Unset endpoints are reported as needs_configuration.
# See DATA_NOTES.md for normalized fields; credentials are HTTP headers, never URLs.
LME_DATA_URL=
LME_AUTH_HEADERS={}
MYSTEEL_DATA_URL=
MYSTEEL_AUTH_HEADERS={}
# Optional public/authorized replacement ONLY when the task owner accepts GFEX lithium.
GFEX_DATA_URL=
GFEX_AUTH_HEADERS={}
